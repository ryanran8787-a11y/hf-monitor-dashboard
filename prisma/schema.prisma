generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase transaction pooler (6543)
  directUrl = env("DIRECT_URL")   // Supabase session pooler (5432)，給 migrate/db push 用
}

// 全站熱門快照：每次 collector 跑完寫一輪
model Snapshot {
  id        Int      @id @default(autoincrement())
  kind      String   // model | dataset | space
  hfId      String
  author    String?
  likes     Int      @default(0)
  downloads Int      @default(0)
  task      String?
  tags      String   @default("[]")
  lastModified String?
  rank      Int      @default(0)
  sortBy    String   @default("likes") // 本輪排序依據
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([kind, sortBy, createdAt])
  @@index([hfId, createdAt])
}

// 單一 repo 的歷史曲線（Top N + 使用者追蹤才會持續寫）
// rank/sortBy：該筆是從哪個榜單第幾名抓到的，給詳情頁畫排名曲線用（舊資料此二欄為空）
model MetricHistory {
  id        Int      @id @default(autoincrement())
  kind      String
  hfId      String
  likes     Int
  downloads Int
  rank      Int?
  sortBy    String   @default("likes")
  task      String?  // pipeline_tag，給流派趨勢用（2026-09-23 起才有值，舊資料為空）
  createdAt DateTime @default(now())

  @@index([kind, hfId, createdAt])
  @@index([kind, hfId, sortBy, createdAt])
  @@index([kind, sortBy, createdAt])
}

// 漲幅告警用：每個 repo 見過的最大值。突破峰值 + 超過閾值才通知。
model Peak {
  id        Int      @id @default(autoincrement())
  kind      String
  hfId      String
  likes     Int      @default(0)
  downloads Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([kind, hfId])
}

// 使用者追蹤清單（單人專案，全站一份無登入）：collector 每輪多抓這些，冷門模型也有曲線
model Watch {
  id        Int      @id @default(autoincrement())
  kind      String
  hfId      String
  createdAt DateTime @default(now())

  @@unique([kind, hfId])
  @@index([createdAt])
}

// 日報去重：同一天（台北日期）只發一次
model DigestLog {
  date      String   @id // yyyy-MM-dd（Asia/Taipei）
  createdAt DateTime @default(now())
}

// 看門狗節流：斷收告警發過一次後，N 小時內不再重發（避免每小時洗版）
model WatchdogState {
  key         String   @id @default("collect-freshness")
  lastAlertAt DateTime?
  updatedAt   DateTime @updatedAt
}
