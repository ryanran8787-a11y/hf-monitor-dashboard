# 本機開發：SQLite 零設定（schema provider 切回 sqlite 即可）。
# 上線 / Actions：Supabase Postgres（Connect → ORMs → Prisma 拿這兩條）
# DATABASE_URL="postgresql://postgres.xxx:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxx:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"
DATABASE_URL="file:./dev.db"
DIRECT_URL=""
HF_TOKEN=""
# Discord 漲幅告警（Server 設定 → 整合 → Webhook 複製 URL）。不填就不推播。
DISCORD_WEBHOOK_URL=""
# 告警閾值：下載增量>=5000且漲幅>=30%，或 likes 增量>=100且漲幅>=30%
SPIKE_MIN_DL="5000"
SPIKE_MIN_LIKES="100"
SPIKE_PCT="30"
